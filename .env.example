# Frontend API base URL
VITE_API_BASE_URL=http://localhost:5000/api

# Frontend public URL
VITE_SITE_URL=http://localhost:5173

# Backend/local development origin
FRONTEND_URL=http://localhost:5173
# Optional Brevo transactional template ID. Leave blank to use the built-in HTML OTP email.
# If set, it must be a positive numeric Brevo template ID.
BREVO_OTP_TEMPLATE_ID=

# --- Payments ---------------------------------------------------------------
# razorpay (default) | test. "test" uses the in-process test gateway that runs
# the SAME verify/post-processing lifecycle; it is REFUSED in production.
PAYMENT_GATEWAY_MODE=razorpay
# Test gateway only (never set in production): success | failure | timeout |
# invalid_signature | refund_failure
# TEST_PAYMENT_SCENARIO=success
# Platform share of each captured payment, percent (default 10)
# PLATFORM_FEE_PERCENT=10
