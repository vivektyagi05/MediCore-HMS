# ============================================================
# MediCore HMS — Environment Configuration
# ============================================================
# Copy this file to .env and replace every required value.
# Never commit .env or real secrets to Git.
# Email delivery uses Brevo HTTP API — SMTP is not used.
# ============================================================


# ------------------------------------------------------------
# Application
# ------------------------------------------------------------

NODE_ENV=development
# Set NODE_ENV=production on Render/production only.
PORT=5000

# Frontend origin allowed by the backend
CORS_ORIGIN=http://localhost:5173

# Public frontend URL
FRONTEND_URL=http://localhost:5173

# Render/Nginx reverse-proxy hop count. Use 0 for direct local development.
TRUST_PROXY=0


# ------------------------------------------------------------
# MongoDB
# ------------------------------------------------------------

# Local development example:
# MONGO_URI=mongodb://127.0.0.1:27017/hms_pro

# MongoDB Atlas example:
# MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/hms_pro

MONGO_URI=


# ------------------------------------------------------------
# Authentication
# ------------------------------------------------------------

JWT_SECRET=
JWT_EXPIRES_IN=7d

# Password hashing
BCRYPT_SALT_ROUNDS=12


# ------------------------------------------------------------
# Rate Limiting
# ------------------------------------------------------------

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=2500
PUBLIC_RATE_LIMIT_WINDOW_MS=60000
PUBLIC_RATE_LIMIT_MAX=180


# ------------------------------------------------------------
# Razorpay
# ------------------------------------------------------------

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=



# ------------------------------------------------------------
# Consultation / Billing
# ------------------------------------------------------------

CONSULTATION_TAX_RATE=18


# ------------------------------------------------------------
# Brevo Transactional Email
# ------------------------------------------------------------
# MediCore uses Brevo's HTTP API.
# Do NOT configure SMTP/Nodemailer SMTP here.

BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=MediCore

# Optional Brevo transactional template.
# Leave blank when inline transactional HTML is used.
BREVO_OTP_TEMPLATE_ID=



# ------------------------------------------------------------
# Hospital Information
# ------------------------------------------------------------

HOSPITAL_NAME=HMS Pro Hospital
HOSPITAL_GSTIN=NOT_APPLICABLE
HOSPITAL_ADDRESS=123 Care Avenue, Bengaluru, India
HOSPITAL_EMAIL=
HOSPITAL_PHONE=


# ------------------------------------------------------------
# Invoice Storage
# ------------------------------------------------------------

# Directory used for generated invoice files.
# Keep this outside public/static frontend assets.
INVOICE_STORAGE_DIR=


# ------------------------------------------------------------
# SEO
# ------------------------------------------------------------

# Public canonical site URL.
# Development:
SEO_SITE_URL=http://localhost:5173


# ------------------------------------------------------------
# Seed Super Admin
# ------------------------------------------------------------
# Used only for controlled initial development/setup.
# Never use the example credentials in a real deployment.

SEED_SUPER_ADMIN_NAME=MediCore Super Admin
SEED_SUPER_ADMIN_EMAIL=superadmin@example.com
SEED_SUPER_ADMIN_PASSWORD=