# Dependencies
node_modules/
backend/node_modules/

# Environment files (never commit real secrets)
.env
.env.*
!.env.example
!backend/.env.example

# Build output
dist/
build/

# Uploaded file storage (invoices, prescriptions, reports, insurance docs)
# This directory is written to at runtime and must be backed by a volume
# in production — see docker-compose.yml. It is not source and should not
# be committed.
backend/storage/
storage/

# Test / coverage
coverage/
.nyc_output/

# Logs
*.log
npm-debug.log*
logs/

# OS files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/
*.swp
*.swo

# Misc
*.local
