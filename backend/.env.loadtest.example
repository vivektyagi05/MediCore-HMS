# Load-test seeder — TEST-ONLY settings. Copy values into your shell (do NOT put these in a deployed environment).
# The seeder never uses the application's MONGO_URI.
SEED_LOAD_TEST=1
# Disposable database only; the name must end in _loadtest or _test (e.g. medicore_loadtest).
MONGO_URI_TEST=mongodb://127.0.0.1:27017/medicore_loadtest
# Test-only password shared by all synthetic accounts (min 12 chars). Never printed by the tool.
LOAD_TEST_PASSWORD=change-me-test-only-password
# Optional: BCRYPT_SALT_ROUNDS=12
